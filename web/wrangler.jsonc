{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "beer-counter",
	"compatibility_date": "2025-11-07",
	"assets": {
		"directory": "build",
		"not_found_handling": "single-page-application"
	},
	"routes": [
		{
			"custom_domain": true,
			"pattern": "beer.omfj.no"
		}
	],
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true
		}
	}
}
