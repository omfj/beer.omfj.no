{
	"name": "beer-counter",
	"private": true,
	"version": "0.0.1",
	"packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
	"scripts": {
		"dev": "pnpm --recursive --parallel dev",
		"storage:up": "docker compose up -d storage",
		"storage:down": "docker compose down",
		"build": "pnpm --recursive build",
		"check": "pnpm format:check && pnpm lint",
		"format": "pnpm --recursive format",
		"format:check": "pnpm --recursive format:check",
		"lint": "pnpm --recursive lint",
		"test": "pnpm --recursive test",
		"sqlx:prepare": "cargo sqlx prepare --workspace --database-url sqlite://$PWD/beer-api/dev.db",
		"deploy": "pnpm --filter beer-web run deploy"
	}
}
